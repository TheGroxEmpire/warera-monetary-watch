DATABASE_URL=postgresql+asyncpg://postgres:postgres@monetary-watch-postgres:5432/warera_monetary_watch
WARERA_API_BASE_URL=https://gateway.warerastats.io/trpc # or https://api2.warera.io/trpc (This is the original API endpoint)
WARERA_API_TOKEN=
WARERA_API_RATE_LIMIT_PER_MINUTE=500
WARERA_API_LOOKUP_BATCH_SIZE=100
WARERA_API_LOOKUP_CONCURRENCY=15
APP_BASE_PATH=/monetary-watch
WARERA_HOST=warera.example.com
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_PUBLISHED_PORT=8000
COLLECTOR_POLL_INTERVAL_SECONDS=30
COLLECTOR_MAX_PAGES_PER_CYCLE=2500
COLLECTOR_INGEST_BATCH_SIZE=200
COUNTRY_METADATA_REFRESH_SECONDS=600
# Applies to raw wage events and hourly tax rollups.
RAW_RETENTION_DAYS=90
LOG_LEVEL=INFO
AUTHENTIK_AUTH_ENABLED=false
AUTHENTIK_BASE_URL=https://auth.example.com
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_ALLOWED_GROUP=warera-monetary-watch-access
AUTH_SESSION_SECRET_KEY=
AUTH_SESSION_COOKIE_NAME=warera_monetary_watch_session
